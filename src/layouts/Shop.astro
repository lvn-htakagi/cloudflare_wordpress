---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import ShopHeader from "../components/ShopHeader.astro";
import ShopFooter from "../components/ShopFooter.astro";

interface Props {
    title: string;
    pageTitle?: string | null;
    description?: string | null;
    image?: string | null;
    canonical?: string | null;
    robots?: string | null;
    type?: "website" | "article";
    publishedTime?: string | null;
    modifiedTime?: string | null;
    author?: string | null;
    /** Pass content reference for plugin page contributions on content pages */
    content?: { collection: string; id: string; slug?: string | null };
}

const {
    title,
    pageTitle,
    description,
    image,
    canonical,
    robots,
    type = "website",
    publishedTime,
    modifiedTime,
    author,
    content,
} = Astro.props;

const [settingsResult, menuResult] = await Promise.all([
    getSiteSettingsWithCacheHint(),
    getMenuWithCacheHint("primary"),
]);

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
    settingsResult.data,
);

const titleIncludesSiteName =
    title === siteTitle ||
    title.endsWith(` | ${siteTitle}`) ||
    title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const pageCtx = createPublicPageContext({
    Astro,
    kind: content ? "content" : "custom",
    pageType: type,
    title: fullTitle,
    pageTitle: pageTitle ?? title,
    description,
    canonical,
    image,
    content,
    seo: { ogImage: image, robots },
    articleMeta: { publishedTime, modifiedTime, author },
    siteName: siteTitle,
});

---

<!DOCTYPE html>
<html lang="ja">
<head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# article: http://ogp.me/ns/article#">
    <EmDashHead page={pageCtx} />
    <meta charset="UTF-8" />
    <title>{fullTitle}</title>
    <meta name="viewport" content="width=device-width" />

    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={image} />}

    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots ?? "index,follow"} />

    <link rel="icon" href="/favicon.ico" type="image/ico" sizes="16x16" />

    <link rel="stylesheet" href="/css/common.css" />

    <slot name="headCss" />
    <slot name="jsonLd" />
</head>
<body>
    <EmDashBodyStart page={pageCtx} />
    <ShopHeader />
    <slot />
    <EmDashBodyEnd page={pageCtx} />
    <ShopFooter />
</body>
</html>
