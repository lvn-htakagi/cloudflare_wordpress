---
import Shop from "../../../layouts/Shop.astro";

import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import { env } from "cloudflare:workers";
// import { resolveBlogSiteIdentity } from "../utils/site-identity";
const { year } = Astro.params;
const currentYear = String(year);
const testMessage = env.PUBLIC_TEST_VAR;
const noImageUrl = env.NO_IMAGE_URL;

// DB読み込み
const [{ entries: shops , cacheHint }] = await Promise.all([
	getEmDashCollection("shops", {
		orderBy: { created_at: "asc" },
        where: { year: currentYear },
	})
]);


const prefNames: Record<number, string> = {
    1: "北海道",
    2: "青森県",
    3: "岩手県",
    4: "宮城県",
    5: "秋田県",
    6: "山形県",
    7: "福島県"
};

// グルーピング（既存の変数名・構造を維持）
const groupedShops = shops.reduce((acc: any, shop: any) => {
    const prefId = shop.data.prefecture_id;

    if (!acc[prefId]) {
        acc[prefId] = [];
    }

    acc[prefId].push(shop);
    return acc;
}, {} as Record<number, any>);

// ない都道府県を除外
const activePrefIds = Object.keys(groupedShops)
    .map(Number)
    .sort((a, b) => a - b);

// 過去の一覧リンク（2020年〜前年）
const pastYears = Array.from(
    { length: Math.max(0, new Date().getFullYear() - 2020) },
    (_, i) => 2020 + i
);

// キャッシュ
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Shop title={`Shops for ${currentYear}`}>
    <link
        slot="headCss"
        rel="stylesheet"
        href="/css/top.css"
    />
    <script
        is:inline
        src="https://code.jquery.com/jquery-3.7.1.min.js"
    ></script>
    <script
        is:inline
        src="/js/fadeIn.js"
    ></script>
    <section id={`logoList_top${Number(year) !== new Date().getFullYear() ? "_past" : ""}`}>
        <div class="contentsInner">
            <p class="sectionTitle mincho">
                ベスト不動産カンパニー一覧
            </p>

            {activePrefIds.length > 0 ? (
                activePrefIds.map((prefId) => (
                    <div class="prefectureDiv">
                        <p class="prefectureName mincho">
                            {prefNames[prefId] || `都道府県コード: ${prefId}`}
                        </p>

                        <ul class="fadein">
                            {groupedShops[prefId].map((shop: { data: { name: string; detail: string; image: any }; slug: string }) => (
                                <li>
                                    <a href={`/shops/${year}/${shop.slug}`}>
                                        {shop.data.image && (
                                            <Image image={shop.data.image} />
                                        )}

                                        <p class="corpName">
                                            {shop.data.name}
                                        </p>
                                    </a>
                                </li>
                            ))}

                            {groupedShops[prefId].length === 2 && (
                                <li></li>
                            )}
                        </ul>
                    </div>
                ))
            ) : (
                <p>登録されているお店はありません。</p>
            )}

            <div id="pastpageList">
                <p>過去のベスト不動産カンパニー一覧</p>

                <ul>
                    {pastYears.map((pastYear) => (
                        <li>
                            <a href={`/shops/${pastYear}/`}>
                                {pastYear}年
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>

        <div id="footerTown">
            <img src="/images/footerTown.png" alt="" />
        </div>
    </section>

    <div id="breadcrumbBottom" class="sp">
        <a href="https://www.lvnmatch.com/" rel="nofollow">
            不動産の比較サイト リビンマッチ
        </a>
        &nbsp;&gt;&nbsp;ベスト不動産カンパニー
    </div>
</Shop>
