---
import Shop from "../../../layouts/Shop.astro";

import { getEmDashEntry } from "emdash";
import { Image } from "emdash/ui"
import { env } from "cloudflare:workers";

const { year, slug } = Astro.params;

const { entry: shop } = await getEmDashEntry("shops", slug as string, {
	references: {
		shop_histories: true
	}
});

const noImageUrl = env.NO_IMAGE_URL;
if (!shop) {
    return Astro.redirect("/404");
}
---

<Shop title={shop.data.name}>
    {/* 一覧ページ（index.astro）に戻るリンク */}
    <a href={`/shops/${year}`} class="back-link">← {year}年の一覧に戻る</a>

    <div class="shop-container">
        {shop.data.image ? (
            <Image 
                image={shop.data.image} 
                alt={shop.data.name}
                style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 12px; margin-bottom: 20px;"
            />
        ) : <img src={noImageUrl} alt="No image available" style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 12px; margin-bottom: 20px;" />} 

        <h1>{shop.data.name}</h1>
        {shop.data.introduction &&(
            <>
                <h2 class="comment-title">企業紹介</h2>
                <p class="comment-box detail-text">{shop.data.introduction}</p>
            </>
        )}
        {shop.references?.shop_histories?.entries && shop.references.shop_histories.entries.length > 0 && (
            <>
                <h2 class="comment-title">お店の歴史</h2>
                <ul class="timeline">
                    {/* shop_histories のまま、中で年(year)・月(month)の並び替えを実行 */}
                    {shop.references.shop_histories.entries
                        .sort((a: any, b: any) => {
                            // 第1条件：年（year）で比較（古い順）
                            const yearDiff = Number(a.data?.year || 0) - Number(b.data?.year || 0);
                            if (yearDiff !== 0) return yearDiff;
                            // 第2条件：月（month）で比較（同じ年なら月の古い順）
                            return Number(a.data?.month || 0) - Number(b.data?.month || 0);
                        })
                        .map((history: any) => (
                            <li class="timeline-item">
                                {/* 年月を表示（管理画面に月があれば月も自動表示） */}
                                <span class="timeline-year">
                                    {history.data?.year}年
                                    {history.data?.month && `${history.data.month}月`}
                                </span>
                                {/* 出来事の本文（detail） */}
                                <p class="timeline-event">{history.data?.detail}</p>
                            </li>
                        ))
                    }
                </ul>
            </>
        )}

        <>
            <h2 class="comment-title">会社概要</h2>
            
            <table class="company-table">
                <tbody>
                    <tr>
                        <th>会社名</th>
                        <td>{shop.data.company_name}</td>
                    </tr>
                    <tr>
                        <th>所在地</th>
                        <td>{shop.data.address}</td>
                    </tr>
                    <tr>
                        <th>電話番号</th>
                        <td>{shop.data.tel}</td>
                    </tr>
                    <tr>
                        <th>FAX番号</th>
                        <td>{shop.data.fax}</td>
                    </tr>
                    <tr>
                        <th>url</th>
                        <td>{shop.data.url}</td>
                    </tr>
                    <tr>
                        <th>資本金</th>
                        <td>{shop.data.capital}</td>
                    </tr>
                    <tr>
                        <th>売上高</th>
                        <td>{shop.data.net_sales}</td>
                    </tr>
                    <tr>
                        <th>事業内容</th>
                        <td>{shop.data.business_content}</td>
                    </tr>
                </tbody>
            </table>
        </>


        {shop.data.interview &&(
            <>
                <h2 class="comment-title">インタビュー</h2>
                <p class="comment-box detail-text">{shop.data.interview}</p>
            </>
        )}
        {shop.data.comment &&(
            <>
                <h2 class="comment-title">編集部コメント</h2>
                <p class="comment-box detail-text">{shop.data.comment}</p>
            </>
        )}
    </div>
</Shop>