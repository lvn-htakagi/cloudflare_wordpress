---
import { getEmDashEntry } from "emdash";
import { Image } from "emdash/ui"

const { year, slug } = Astro.params;

const { entry: shop } = await getEmDashEntry("shops", slug as string, {
	references: {
		shop_histories: true
	}
});

console.log(shop);
if (!shop) {
    return Astro.redirect("/404");
}
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>詳細情報</title>
    <style>
        body {
            color: #e2e8f0;
            font-family: sans-serif;
            padding: 40px 20px;
            background: #0f172a; /* 黒背景（ダークモード） */
            max-width: 800px;
            margin: 0 auto;
        }
        .back-link {
            color: #38bdf8;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 20px;
        }
        .back-link:hover { text-decoration: underline; }
        .shop-container {
            background: #1e293b;
            border: 1px solid #334155;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
        }
        h1 {
            color: #ffffff;
            margin-top: 0;
            border-bottom: 2px solid #334155;
            padding-bottom: 15px;
        }
        .detail-text {
            color: #94a3b8;
            line-height: 1.8;
            font-size: 1.1rem;
            white-space: pre-wrap;
        }
        
        .comment-title {
            color: #ffffff;
            font-size: 1.3rem;
            margin-top: 40px;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #334155;
            position: relative;
        }

        .comment-title::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 40px;
            height: 2px;
            background-color: #38bdf8;
        }

        .comment-box {
            background: #1e293b; /* コンテナよりさらに一段階明るいネイビーグレー */
            border-left: 4px solid #38bdf8; /* 左側にアクセントラインを入れて引き締める */
            padding: 20px;
            border-radius: 0 12px 12px 0; /* 左側はラインがあるので右側だけ角丸に */
            color: #e2e8f0; /* 文字色は明るく読みやすく */
            font-size: 1rem;
            line-height: 1.7;
            position: relative;
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.3); /* 内側にうっすら影を入れて凹凸感を出す */
        }

        /* タイムライン全体のコンテナ */
        .timeline {
            list-style: none;
            padding: 0;
            margin: 20px 0 0 10px;
            position: relative;
        }

        /* タイムラインの「縦線」 */
        .timeline::before {
            content: '';
            position: absolute;
            top: 8px;
            bottom: 8px;
            left: 6px;
            width: 2px;
            background-color: rgba(255, 255, 255, 0.15);
        }

        /* 各歴史要素のまとまり */
        .timeline-item {
            position: relative;
            padding-left: 28px;
            margin-bottom: 24px;
        }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

        /* タイムラインの「ドット（丸）」 */
        .timeline-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 6px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background-color: #0070f3;
            border: 3px solid #111a2e; /* 背景色でフチ取りして線と被らないように見せる */
            box-shadow: 0 0 0 2px rgba(0, 112, 243, 0.2);
            z-index: 1;
        }

        /* 「年・月」のスタイル */
        .timeline-year {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: #0070f3;
            margin-bottom: 4px;
        }

        /* 「出来事（detail）」のスタイル */
        .timeline-event {
            margin: 0;
            font-size: 15px;
            color: rgba(255, 255, 255, 0.85);
            line-height: 1.6;
        }

        /* 会社概要のコンテナ */
        .company-info-container {
            margin-top: 40px;
            width: 100%;
        }

        /* テーブル全体のスタイル */
        .company-table {
            width: 100%;
            border-collapse: collapse; /* 枠線を1本にまとめる */
            margin-top: 20px;
            font-size: 15px;
            text-align: left;
        }

        /* 各行のスタイル（下線をつけて境界を分ける） */
        .company-table tr {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1); /* うっすら見える白い下線 */
        }

        /* 最後の行だけ下線を消す */
        .company-table tr:last-child {
            border-bottom: none;
        }

        /* 左側：見出し（th）のスタイル */
        .company-table th {
            width: 25%; /* 見出しの横幅（お好みで調整してください） */
            padding: 16px 8px;
            color: #0070f3; /* タイムラインのドットと合わせたアクセントブルー */
            font-weight: 700;
            vertical-align: top; /* 文字が複数行になっても上に揃える */
        }

        /* 右側：データ（td）のスタイル */
        .company-table td {
            padding: 16px 8px;
            color: rgba(255, 255, 255, 0.9); /* 読みやすい少し明るめの白 */
            line-height: 1.6;
        }

        /* 📱 スマホ対応（画面が狭いときは縦並びにする） */
        @media (max-width: 640px) {
            .company-table th,
            .company-table td {
                display: block;
                width: 100%;
                padding: 8px 0;
            }
        
            .company-table th {
                padding-top: 16px;
                color: #0070f3;
            }
        
            .company-table td {
                padding-bottom: 16px;
            }
        }

    </style>
</head>
<body>

    {/* 一覧ページ（index.astro）に戻るリンク */}
    <a href={`/shops/${year}`} class="back-link">← {year}年の一覧に戻る</a>

    <div class="shop-container">
        {shop.data.image ? (
            <Image 
                image={shop.data.image} 
                alt={shop.data.name}
                style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 12px; margin-bottom: 20px;"
            />
        ) : <img src="/_emdash/api/media/file/01M47D65RTFX1465XKASEPK4QD.01M47D65TEQN4C4H9JY3PNGCZY.png" alt="No image available" style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 12px; margin-bottom: 20px;" />} 

        <h1>{shop.data.name}</h1>
        {shop.data.introduction &&(
            <>
                <h2 class="comment-title">企業紹介</h2>
                <p class="comment-box detail-text">{shop.data.introduction}</p>
            </>
        )}
        {shop.references?.shop_histories?.entries && shop.references.shop_histories.entries.length > 0 && (
            <>
                <h2 class="comment-title">お店の歴史</h2>
                <ul class="timeline">
                    {/* shop_histories のまま、中で年(year)・月(month)の並び替えを実行 */}
                    {shop.references.shop_histories.entries
                        .sort((a: any, b: any) => {
                            // 第1条件：年（year）で比較（古い順）
                            const yearDiff = Number(a.data?.year || 0) - Number(b.data?.year || 0);
                            if (yearDiff !== 0) return yearDiff;
                            // 第2条件：月（month）で比較（同じ年なら月の古い順）
                            return Number(a.data?.month || 0) - Number(b.data?.month || 0);
                        })
                        .map((history: any) => (
                            <li class="timeline-item">
                                {/* 年月を表示（管理画面に月があれば月も自動表示） */}
                                <span class="timeline-year">
                                    {history.data?.year}年
                                    {history.data?.month && `${history.data.month}月`}
                                </span>
                                {/* 出来事の本文（detail） */}
                                <p class="timeline-event">{history.data?.detail}</p>
                            </li>
                        ))
                    }
                </ul>
            </>
        )}

        <>
            <h2 class="comment-title">会社概要</h2>
            
            <table class="company-table">
                <tbody>
                    <tr>
                        <th>会社名</th>
                        <td>{shop.data.company_name}</td>
                    </tr>
                    <tr>
                        <th>所在地</th>
                        <td>{shop.data.address}</td>
                    </tr>
                    <tr>
                        <th>電話番号</th>
                        <td>{shop.data.tel}</td>
                    </tr>
                    <tr>
                        <th>FAX番号</th>
                        <td>{shop.data.fax}</td>
                    </tr>
                    <tr>
                        <th>url</th>
                        <td>{shop.data.url}</td>
                    </tr>
                    <tr>
                        <th>資本金</th>
                        <td>{shop.data.capital}</td>
                    </tr>
                    <tr>
                        <th>売上高</th>
                        <td>{shop.data.net_sales}</td>
                    </tr>
                    <tr>
                        <th>事業内容</th>
                        <td>{shop.data.business_content}</td>
                    </tr>
                </tbody>
            </table>
        </>


        {shop.data.interview &&(
            <>
                <h2 class="comment-title">インタビュー</h2>
                <p class="comment-box detail-text">{shop.data.interview}</p>
            </>
        )}
        {shop.data.comment &&(
            <>
                <h2 class="comment-title">編集部コメント</h2>
                <p class="comment-box detail-text">{shop.data.comment}</p>
            </>
        )}
    </div>

</body>
</html>
