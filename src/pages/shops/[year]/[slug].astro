---
import Shop from "../../../layouts/Shop.astro";

import { getEmDashEntry } from "emdash";
import { Image } from "emdash/ui"
import { env } from "cloudflare:workers";

const { year, slug } = Astro.params;

const { entry: shop } = await getEmDashEntry("shops", slug as string, {
	references: {
		shop_histories: true
	}
});

const prefNames: Record<number, string> = {
    1: "北海道",
    2: "青森県",
    3: "岩手県",
    4: "宮城県",
    5: "秋田県",
    6: "山形県",
    7: "福島県"
};

if (!shop) {
    return Astro.redirect("/404");
}
---

<Shop title={`${shop.data.name}`}>
    <link
        slot="headCss"
        rel="stylesheet"
        href="/css/detail.css"
    />
    <script
        is:inline
        src="https://code.jquery.com/jquery-3.7.1.min.js"
    ></script>
    <script
        is:inline
        src="/js/fadeIn.js"
    ></script>
    <div class="contentsInner">
        <section>
            <div id="corpInfo">
                <h2>
                    <img
                        src="/images/laurel.png"
                        alt="ベスト不動産カンパニー"
                    />
                    <span>{prefNames[Number(shop.data.prefecture_id)] || ""}</span>
                </h2>

                <div id="corpLogo">
                    <Image
                        image={shop.data.image}
                        alt={shop.data.company_name || shop.data.name}
                    />
                </div>
            </div>

            <div id="presidentDiv">
                <div id="profileSection">
                    <div id="presidentPh">
                        <Image
                            image={shop.data.face}
                        />
                    </div>
                    <div id="profile">
                        <p id="presidentName">{shop.data.president}</p>
                        <div id="biography">
                            <p>【略歴】</p>
                            <pre>{shop.data.career}</pre>
                        </div>
                    </div>
                </div>
                {shop.data.introduction && (
                    <div id="corpIntroduction">
                        <p>企業紹介</p>
                        <pre>{shop.data.introduction}</pre>
                    </div>
                )}
                {shop.data.interviews && shop.data.interviews.length > 0 && (
                    <div id="interview">
                        <p>インタビュー</p>
                        <dl>
                            {shop.data.interviews.map((interview: any) => (
                                <dt>{interview['question']}</dt>
                                <dd><pre>{interview['answer']}</pre></dd>
                            ))}
                        </dl>
                    </div>
                )}
            </div>
        </section>

        {/* 企業概要 */}
        <section id="overview">
            <p>企業概要</p>

            <dl>
                <dt>会社名</dt>
                <dd>{shop.data.company_name || shop.data.name}</dd>

                <dt>所在地</dt>
                <dd>{shop.data.address}</dd>

                <dt>電話番号</dt>
                <dd>{shop.data.tel}</dd>

                <dt>FAX番号</dt>
                <dd>{shop.data.fax}</dd>

                <dt>URL</dt>
                <dd>
                    {shop.data.url && (
                        <a
                            href={shop.data.url}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {shop.data.url}
                        </a>
                    )}
                </dd>

                <dt>資本金</dt>
                <dd>{shop.data.capital}</dd>

                <dt>売上高</dt>
                <dd><pre>{shop.data.net_sales}</pre></dd>

                <dt>事業内容</dt>
                <dd><pre>{shop.data.business_content}</pre></dd>

                <dt>許認可・免許番号</dt>
                <dd><pre>{shop.data.license_number}</pre></dd>

                <dt>従業員数</dt>
                <dd>{shop.data.employee}</dd>

                <dt>加盟団体</dt>
                <dd><pre>{shop.data.organizations}</pre></dd>

                <dt>設立年月</dt>
                <dd>{shop.data.establishment}</dd>

                <dt>拠点</dt>
                <dd><pre>{shop.data.base}</pre></dd>

                <dt>関係会社</dt>
                <dd><pre>{shop.data.relationship}</pre></dd>
            </dl>
        </section>

        {/* 沿革 */}
        {shop.data.histories && shop.data.histories.length > 0 && (
            <section id="history">
                <p>沿革</p>
                <dl>
                    {shop.data.histories.map((image: any) => (
                        <>
                            <dt>
                                {image.year}年
                                {image.month
                                    ? `${image.month}月`
                                    : ""}
                            </dt>
                            <dd>
                                <pre>{image.detail}</pre>
                            </dd>
                        </>
                    ))}
                </dl>
            </section>
        )}

        {/* フォトギャラリー */}
        {shop.data.gallery && shop.data.gallery.length > 0 && (
            <section id="gallery">
                <p>フォトギャラリー</p>

                <ul class="fadein">
                    {shop.data.gallery.map((image: any) => (
                        <li>
                            <Image
                                image={image.media}
                                alt={image.media.alt}
                            />
                            <span class="photoDdesc">{image.media.alt}</span>
                        </li>
                    ))}
                </ul>
            </section>
        )}

        {/* 編集部コメント */}
        {shop.data.comment && (
            <section id="editorialComment">
                <p id="editorTitle">
                    <img
                        src="/images/pen.svg"
                        alt="編集部コメント"
                    />
                    編集部コメント
                </p>
                <pre>{shop.data.comment}</pre>
            </section>
        )}

        {/* お問い合わせ */}
        <section id="inquiryBtn">
            <a
                href={`https://www.lvnmatch.com/shop/form?detail_urls%5B%5D=${encodeURIComponent(Astro.url.href)}`}
            >
                <img
                    src="/images/inquiryBtn.png"
                    width="404"
                    height="70"
                    alt="この会社に問い合わせる"
                />
            </a>
        </section>
    </div>

    <div id="breadcrumbBottom" class="sp">
        <a href="/">
            ベスト不動産カンパニー
        </a>
        &nbsp;&gt;&nbsp;
        {shop.data.company_name || shop.data.name}
    </div>
</Shop>
