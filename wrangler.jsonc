{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-emdash-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "account_id": "22525dc2d0008628469dc1e0e54745ae",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-emdash-site",
      "database_id": "6f15a7f1-8a25-4c35-afb5-bfc8a0a05c56",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "my-emdash-media",
    },
  ],
  // Sandboxed plugins require Worker Loader, available on Workers paid plans.
  "worker_loaders": [{ "binding": "LOADER" }],
  // General maintenance cron trigger
  "triggers": {
    "crons": ["* * * * *"],
  },
}
